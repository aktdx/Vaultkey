# ============================================================
# VaultKey — .gitignore
# ============================================================

# ── Environment variables & secrets ─────────────────────────
.env
.env.*
!.env.example
!.env.*.example

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# Virtual environments
venv/
.venv/
env/
.env/
ENV/

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── Database ─────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Local SQLite remnants (no longer used in production) ─────
backend/vaultkey.db
backend/storage/

# ── Node / Frontend ──────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/.vite/
frontend/node_modules/.vite/
frontend/package-lock.json
frontend/dist/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS & editor noise ────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
overview.md 

backend/app/__pycache__/*