# ============================================================
# VaultKey Backend — environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=replace_with_a_strong_random_secret

# ── Neon PostgreSQL ────────────────────────────────────────────────────────────
# Found in: Neon console → your project → Connection Details → Connection string
# Format:   postgresql://user:password@host/dbname?sslmode=require
# Note:     'postgres://' is also accepted — we normalise it automatically.
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/vaultkey?sslmode=require

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
# R2_ACCOUNT_ID  : Cloudflare dashboard → right sidebar → Account ID
# R2_BUCKET_NAME : R2 → your bucket name
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY :
#   R2 → Manage R2 API tokens → Create API token (Object Read & Write)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET_NAME=vaultkey-files
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# ── Server ────────────────────────────────────────────────────────────────────
# Port the server listens on (used by Procfile / Heroku / Railway).
PORT=8000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins. No wildcard ("*") is
# permitted when allow_credentials=True — list every real origin explicitly.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Required for POST /api/auth/google (Firebase ID token verification).
# FIREBASE_SERVICE_ACCOUNT_JSON: paste the ENTIRE service-account JSON as a
#   single line (no newlines). Generated in Firebase Console → Project Settings
#   → Service Accounts → Generate new private key.
# FIREBASE_PROJECT_ID: your Firebase project ID (e.g. my-app-a1b2c).
#   Used as a fallback when FIREBASE_SERVICE_ACCOUNT_JSON is not set.
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your_project_id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}
