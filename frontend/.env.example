# VaultKey Frontend — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ── Backend API ────────────────────────────────────────────────────────────────
# URL of the FastAPI backend (no trailing slash).
# Development: leave unset — Vite proxies /api → http://127.0.0.1:8000 automatically.
# Production: set to your deployed backend URL.
VITE_API_URL=http://localhost:8000
# Production example:
# VITE_API_URL=https://api.yourdomain.com

# ── Application ────────────────────────────────────────────────────────────────
# Public base URL for generating share links (no trailing slash).
VITE_APP_URL=http://localhost:5173
# Production example:
# VITE_APP_URL=https://app.vaultkey.io
