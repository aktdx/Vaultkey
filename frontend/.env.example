# VaultKey Frontend — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ── Backend API ────────────────────────────────────────────────────────────────
# URL of the FastAPI backend (no trailing slash).
# Development: leave unset — Vite proxies /api → http://127.0.0.1:8000 automatically.
# Production: set to your deployed backend URL.
VITE_API_URL=http://localhost:8000
# Production example:
# VITE_API_URL=https://api.yourdomain.com

# ── Application ────────────────────────────────────────────────────────────────
# Public base URL for generating share links (no trailing slash).
VITE_APP_URL=http://localhost:5173
# Production example:
# VITE_APP_URL=https://app.vaultkey.io

# ── Firebase (Google Sign-In) ──────────────────────────────────────────────────
# These values come from Firebase Console → Project Settings → Your apps → Web app.
# They are safe to expose in the frontend (they are not service-account secrets).
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
